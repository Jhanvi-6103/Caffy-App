<?xml version="1.0" encoding="utf-8"?>
<resources>
        <style name="Theme.CoffeeApp" parent="Theme.Material3.DayNight.NoActionBar">

            <!-- Background -->
            <item name="android:colorBackground">@color/coffee_background</item>

            <!-- Surface -->
            <item name="colorSurface">@color/coffee_surface</item>
            <item name="colorOnSurface">@color/coffee_text</item>

            <!-- Primary -->
            <item name="colorPrimary">@color/accent_gold</item>
            <item name="colorOnPrimary">@color/black</item>

            <!-- Secondary -->
            <item name="colorSecondary">@color/brown_medium</item>
            <item name="colorOnSecondary">@color/white</item>

            <!-- System Bars -->
            <item name="android:statusBarColor">@color/coffee_surface</item>
            <item name="android:navigationBarColor">@color/coffee_surface</item>

            <!-- Card Style -->
            <item name="materialCardViewStyle">@style/CoffeeCardStyle</item>

        </style>


    <!-- Card Style (Dark) -->
    <style name="CoffeeCardStyleDark" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/coffee_surface_dark</item>
        <item name="cardElevation">3dp</item>
        <item name="shapeAppearance">@style/CoffeeCardShapeDark</item>
    </style>

    <!-- Rounded Cards (Dark) -->
    <style name="CoffeeCardShapeDark" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>
