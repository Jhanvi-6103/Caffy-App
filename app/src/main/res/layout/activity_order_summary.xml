<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/lightCream">

    <!-- HEADER (unchanged) -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="4dp"
            android:src="@drawable/back"
            android:background="@android:color/transparent"/>

        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Summary"
            android:textColor="@color/darkBrown"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- ORDER CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="10dp"
        android:padding="2dp"
        android:backgroundTint="@color/white"
        app:cardElevation="5dp"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/lightGrey"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/orderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Order ID:"
                android:textColor="@color/darkBrown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Date:"
                android:textStyle="bold"
                android:textColor="@color/darkBrown"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/orderItems"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Items:"
                android:textStyle="bold"
                android:textColor="@color/darkBrown"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/orderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Status: Pending"
                android:textColor="@color/brown"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Amount:"
                android:textColor="@color/darkBrown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Applied offer summary (hidden when none) -->
            <LinearLayout
                android:id="@+id/appliedOfferLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/appliedOfferText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offer Applied: "
                    android:textColor="@color/darkBrown"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/discountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discount: ₹0.00"
                    android:textColor="@color/cafe_accent" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CANCEL BUTTON -->
    <Button
        android:id="@+id/cancelOrderBtn"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="32dp"
        android:text="Cancel Order"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/brown"
        android:textColor="@color/white"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@id/cardLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PAYMENT TITLE -->
    <TextView
        android:id="@+id/paymentTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Payment Method"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/darkBrown"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/cancelOrderBtn"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- GOOGLE PAY OPTION -->
    <LinearLayout
        android:id="@+id/googlePayLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/payment_option_bg"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/paymentTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/google_pay"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pay with Google Pay"
            android:textColor="@color/darkBrown"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- RAZORPAY OPTION -->
    <LinearLayout
        android:id="@+id/razorPayLayout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/payment_option_bg"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/googlePayLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/razor_pay"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pay with Razorpay"
            android:textColor="@color/darkBrown"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- DOWNLOAD RECEIPT -->
    <LinearLayout
        android:id="@+id/downloadReceiptLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/payment_option_bg"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/razorPayLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/downloadIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"/>

        <TextView
            android:id="@+id/downloadText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Receipt"
            android:textColor="@color/darkBrown"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
