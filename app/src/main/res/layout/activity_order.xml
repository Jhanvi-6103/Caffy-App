<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightCream"
    tools:context=".Activity.OrderActivity">

    <!-- ================= HEADER ================= -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="35dp"
        android:paddingBottom="18dp"
        android:paddingHorizontal="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/back"
            android:padding="4dp" />

        <TextView
            android:id="@+id/titleTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="My Orders"
            android:textColor="@color/darkBrown"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- ================== NO ORDERS TEXT ================== -->
    <TextView
        android:id="@+id/noOrdersText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No orders yet"
        android:textColor="@color/darkBrown"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />


    <!-- ================= ORDER LIST ================= -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= BOTTOM NAV ================= -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:background="@color/white"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Explorer -->
        <LinearLayout
            android:id="@+id/explorerBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/explorerIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/btn_1" />

            <TextView
                android:id="@+id/explorerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Explorer"
                android:textColor="@color/darkBrown"
                android:textSize="12sp" />
        </LinearLayout>


        <!-- Cart -->
        <LinearLayout
            android:id="@+id/cartBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/cartIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/btn_2" />

                <!-- 🔥 CART BADGE -->
<!--                <TextView-->
<!--                    android:id="@+id/cartBadge"-->
<!--                    android:layout_width="18dp"-->
<!--                    android:layout_height="18dp"-->
<!--                    android:background="@drawable/badge_bg"-->
<!--                    android:textColor="@color/white"-->
<!--                    android:textSize="10sp"-->
<!--                    android:gravity="center"-->
<!--                    android:visibility="gone"-->
<!--                    android:layout_gravity="end|top"-->
<!--                    android:translationX="10dp"-->
<!--                    android:translationY="-6dp" />-->

            </FrameLayout>

            <TextView
                android:id="@+id/cartText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cart"
                android:textColor="@color/darkBrown"
                android:textSize="12sp" />
        </LinearLayout>


        <!-- Wishlist -->
        <LinearLayout
            android:id="@+id/wishlistBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wishlistIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/btn_3" />

            <TextView
                android:id="@+id/wishlistText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wishlist"
                android:textColor="@color/darkBrown"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>


        <!-- Orders -->
        <LinearLayout
            android:id="@+id/orderBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/orderIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/btn_4" />

            <TextView
                android:id="@+id/orderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Orders"
                android:textColor="@color/darkBrown"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>


        <!-- Profile -->
        <LinearLayout
            android:id="@+id/profileBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/profileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/btn_5" />

            <TextView
                android:id="@+id/profileText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="@color/darkBrown"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
