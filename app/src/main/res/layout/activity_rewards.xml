<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rewards_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_background">


    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cafe_surface"
        android:elevation="4dp"
        android:paddingBottom="4dp">

        <!-- Toolbar-like Title Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/titleRewards"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Rewards"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/cafe_onSurface"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/giftIcon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <ImageView
                android:id="@+id/giftIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="2dp"
                android:src="@drawable/giftbox"
                android:contentDescription="Rewards Icon"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:tabIndicatorColor="@color/cafe_accent"
            app:tabIndicatorHeight="3dp"
            app:tabSelectedTextColor="@color/cafe_accent"
            app:tabTextColor="@color/cafe_onSurfaceVariant"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:overScrollMode="never"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
