<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/lightCream">

    <!-- ===================== REFRESH BUTTON ===================== -->
    <Button
        android:id="@+id/btnRefresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Refresh Achievements"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:backgroundTint="@color/cafe_accent"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:layout_marginBottom="14dp" />

    <!-- ===================== INVALID / TAMPER NOTICE ===================== -->
    <TextView
        android:id="@+id/invalidNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invalid or Tampered Data Detected"
        android:textColor="#DC2D21"
        android:textStyle="bold"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent" />

    <!-- ===================== ACHIEVEMENT LIST ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/achRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>
