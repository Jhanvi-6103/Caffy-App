<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    android:stateListAnimator="@null"
    app:strokeColor="@color/cafe_outline"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Reward Icon -->
        <ImageView
            android:id="@+id/iconReward"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/coffee_beans" />

        <!-- Labels -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reward Title"
                android:textColor="@color/darkBrown"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 coins"
                android:textColor="@color/cafe_accent"
                android:textSize="14sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Redeem Arrow -->
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@drawable/arrow"
            android:layout_marginStart="8dp"
            android:contentDescription="Redeem arrow" />


        <!-- ✔️ Tick Icon when redeemed -->
        <ImageView
            android:id="@+id/tick"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/tick"
            android:visibility="gone"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
