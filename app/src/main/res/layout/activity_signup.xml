<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/coffee_bg1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="30dp"
        android:orientation="vertical">

        <TextView
            android:text="Create Account ☕"
            android:textSize="30sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Name -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Full Name"
            android:textColorHint="#9E8A7D"
            android:padding="14dp" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/rounded_edittext"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:textColorHint="#9E8A7D"
            android:padding="14dp" />

        <!-- Password -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_edittext"
                android:hint="Password"
                android:padding="8dp"
                android:inputType="textPassword"
                android:textColorHint="#9E8A7D" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="18dp"
                android:src="@drawable/ic_eye_hide" />
        </RelativeLayout>

        <!-- Phone -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp">

            <Spinner
                android:id="@+id/spCountryCode"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_edittext"
                android:drawableRight="@drawable/ic_dropdown"
                android:drawablePadding="8dp"
                android:padding="8dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Phone Number"
                android:background="@drawable/rounded_edittext"
                android:inputType="number"
                android:padding="14dp"
                android:layout_marginStart="10dp"
                android:textColorHint="#9E8A7D"/>
        </LinearLayout>

        <!-- Signup Button -->
        <Button
            android:id="@+id/btnSignup"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:backgroundTint="#C5784C"
            android:text="Sign Up"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <!-- OR Divider -->
        <TextView
            android:text="────────  OR  ────────"
            android:textColor="#F4F0F0"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"/>

        <!-- Google Signup -->
        <LinearLayout
            android:id="@+id/btnGoogleSignup"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/google_icon" />

            <TextView
                android:text="Sign up with Google"
                android:layout_marginStart="15dp"
                android:textSize="16sp"
                android:textColor="#5B3A29"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvLoginClick"
            android:text="Already have an account? Login"
            android:textStyle="bold"
            android:textColor="#EFEAE9"
            android:textSize="16sp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
