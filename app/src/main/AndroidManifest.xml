<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/logoo_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logoo_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeeApp">

        <activity
            android:name=".Admin.AdminMainActivity"
            android:exported="false"/>
        <activity
            android:name=".Admin.AdminOrderDetailActivity"
            android:exported="false" />


        <activity
            android:name=".Activity.ForgotPasswordActivity"
            android:exported="false" /> <!-- ADMIN PANEL -->
        <activity
            android:name=".Activity.EditProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.SignupActivity"
            android:exported="true"></activity>
        <activity
            android:name=".Activity.LoginActivity"
            android:exported="true"></activity>
        <activity
            android:name=".Activity.ProceedOrderActivity"
            android:exported="false"></activity>
        <activity
            android:name=".Activity.OrderActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.OrderSummaryActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
        </activity>
        <activity
            android:name=".Activity.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>
        <activity
            android:name=".Activity.CartActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.DetailActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.ItemsListActivity"
            android:exported="false" />
        <activity
            android:name=".Activity.SplashActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".Activity.MainActivity"
            android:exported="true" />
        <activity
            android:name=".Activity.WishlistActivity"
            android:exported="true" />
        <activity
            android:name=".Activity.ProfileActivity"
            android:exported="true" />
        <activity
            android:name=".Rewards.RewardsActivity"
            android:exported="true" />

    </application>

</manifest>